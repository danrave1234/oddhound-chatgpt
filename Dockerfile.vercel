FROM node:26-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe AS build
RUN npm install --global pnpm@11.9.0
WORKDIR /src
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./
COPY apps/web/package.json apps/web/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/browser/package.json apps/browser/package.json
COPY apps/fixture/package.json apps/fixture/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/checks/package.json packages/checks/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/agent/package.json packages/agent/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN pnpm install --frozen-lockfile
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm build

FROM node:26-bookworm-slim@sha256:28147155d47dc31abe0a46e0d12b59b2fb3d0a2dcc5dc65fce76a074180b16fe
WORKDIR /app
ENV NODE_ENV=production HOSTNAME=0.0.0.0 PORT=3000 NEXT_TELEMETRY_DISABLED=1 ODDHOUND_ARTIFACT_STORAGE=postgres
COPY --from=build --chown=node:node /src/apps/web/.next/standalone/ ./
COPY --from=build --chown=node:node /src/apps/web/.next/static/ ./apps/web/.next/static/
COPY --from=build --chown=node:node /src/apps/web/public/ ./apps/web/public/
USER node
EXPOSE 3000
CMD ["node","apps/web/server.js"]
